# Keep line endings identical on every machine. Windows checkouts must not
# turn LF into CRLF: pinned file digests and shell scripts depend on LF.
* text=auto eol=lf

*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows batch files keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.sqlite binary
*.db binary
