{
  "name": "@ai-verse/data",
  "version": "0.1.0-alpha.0",
  "description": "Local-first structured-data layer for AI-Verse OS and compatible agent systems.",
  "type": "module",
  "bin": {
    "ai-verse-data": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./protocol": {
      "types": "./dist/src/protocol/index.d.ts",
      "import": "./dist/src/protocol/index.js"
    },
    "./storage": {
      "types": "./dist/src/storage/index.d.ts",
      "import": "./dist/src/storage/index.js"
    },
    "./scope": {
      "types": "./dist/src/scope/index.d.ts",
      "import": "./dist/src/scope/index.js"
    },
    "./package.json": "./package.json",
    "./catalog": {
      "types": "./dist/src/catalog/index.d.ts",
      "import": "./dist/src/catalog/index.js"
    },
    "./records": {
      "types": "./dist/src/records/index.d.ts",
      "import": "./dist/src/records/index.js"
    },
    "./query": {
      "types": "./dist/src/query/index.d.ts",
      "import": "./dist/src/query/index.js"
    },
    "./transactions": {
      "types": "./dist/src/transactions/index.d.ts",
      "import": "./dist/src/transactions/index.js"
    },
    "./idempotency": {
      "types": "./dist/src/idempotency/index.d.ts",
      "import": "./dist/src/idempotency/index.js"
    },
    "./provenance": {
      "types": "./dist/src/provenance/index.d.ts",
      "import": "./dist/src/provenance/index.js"
    },
    "./bulk": {
      "types": "./dist/src/bulk/index.d.ts",
      "import": "./dist/src/bulk/index.js"
    },
    "./backup": {
      "types": "./dist/src/backup/index.d.ts",
      "import": "./dist/src/backup/index.js"
    },
    "./schema-migrations": {
      "types": "./dist/src/schema-migrations/index.d.ts",
      "import": "./dist/src/schema-migrations/index.js"
    },
    "./recovery": {
      "types": "./dist/src/recovery/index.d.ts",
      "import": "./dist/src/recovery/index.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js"
    },
    "./bots": {
      "types": "./dist/src/bots/index.d.ts",
      "import": "./dist/src/bots/index.js"
    },
    "./brain": {
      "types": "./dist/src/brain/index.d.ts",
      "import": "./dist/src/brain/index.js"
    },
    "./memory": {
      "types": "./dist/src/memory/index.d.ts",
      "import": "./dist/src/memory/index.js"
    },
    "./dashboard": {
      "types": "./dist/src/dashboard/index.d.ts",
      "import": "./dist/src/dashboard/index.js"
    },
    "./native": {
      "types": "./dist/src/native/index.d.ts",
      "import": "./dist/src/native/index.js"
    }
  },
  "files": [
    "dist/src/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run test",
    "start": "node dist/src/cli.js"
  },
  "keywords": [
    "ai",
    "agents",
    "structured-data",
    "sqlite",
    "local-first",
    "ai-verse"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiverse-filmmakers/AI-Verse-Data.git"
  },
  "homepage": "https://github.com/aiverse-filmmakers/AI-Verse-Data#readme",
  "bugs": {
    "url": "https://github.com/aiverse-filmmakers/AI-Verse-Data/issues"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
